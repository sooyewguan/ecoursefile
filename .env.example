# Copy to .env. For the local stack, take the URL and keys from `npx supabase status -o env`.

# Browser app. Vite exposes only VITE_ variables to the page.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Push notifications. On the local stack, fake registers made-up push tokens and needs no Firebase
# project. In production, use fcm, and fill in the web app config from the Firebase console
# (Project settings, General, Your apps). The VAPID key (Project settings, Cloud Messaging, Web Push
# certificates) is optional. Without it, the Firebase SDK uses Firebase's default key.
# Leave VITE_PUSH_ADAPTER out to build a site without push.
VITE_PUSH_ADAPTER=fake
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Seed script (npm run seed). The secret key bypasses RLS: never give it a VITE_ prefix.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
ROOT_EMAIL=root@ecoursefile.test
ROOT_PASSWORD=
# Optional, defaults to "Root".
ROOT_NAME=Root

# Refresh token script (npm run google:token). A Google OAuth client of the Desktop app type.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
