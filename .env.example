# Copy to .env. For the local stack, take the URL and keys from `npx supabase status -o env`.

# Browser app. Vite exposes only VITE_ variables to the page.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Seed script (npm run seed). The secret key bypasses RLS: never give it a VITE_ prefix.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
ROOT_EMAIL=root@ecoursefile.test
ROOT_PASSWORD=
# Optional, defaults to "Root".
ROOT_NAME=Root

# OneDrive check (npm run onedrive:check). See "Checking a OneDrive" in the README.
# app: sign in as the Entra app with its secret and use ONEDRIVE_USER's OneDrive.
# user: sign in as a person with a device code and use their own OneDrive.
ONEDRIVE_SIGN_IN=user
# The tenant ID or domain, or consumers for a personal Microsoft account.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# app only.
GRAPH_CLIENT_SECRET=
ONEDRIVE_USER=
# Optional, defaults to http://localhost:5173. The origin of the app, for the CORS step.
APP_ORIGIN=
